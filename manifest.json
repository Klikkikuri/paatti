{
  "manifest_version": 3,
  "name": "Klikkikuri Paatti",
  "description": "__MSG_extensionDescription__",
  "version": "0.0.10.1",
  "browser_specific_settings": {
    "gecko": {
      "id": "klikkikuri@protonmail.com",
      "strict_min_version": "128.0",
      "update_url": "https://raw.githubusercontent.com/Klikkikuri/paatti/main/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "minimum_chrome_version": "122.0",
  "homepage_url": "https://github.com/klikkikuri",
  "icons": {
    "16": "icons/klikkikuri-16.png",
    "32": "icons/klikkikuri-32.png",
    "48": "icons/klikkikuri-48.png",
    "64": "icons/klikkikuri-64.png",
    "96": "icons/klikkikuri-96.png",
    "128": "icons/klikkikuri-128.png",
    "256": "icons/klikkikuri-256.png"
  },
  "default_locale": "en",
  "action": {
    "default_icon": {
      "16": "icons/klikkikuri-16.png",
      "24": "icons/klikkikuri-24.png",
      "32": "icons/klikkikuri-32.png",
      "48": "icons/klikkikuri-48.png",
      "64": "icons/klikkikuri-64.png"
    },
    "default_title": "Klikkikuri Paatti",
    "default_popup": "src/options/popup.html",
    "default_area": "navbar"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/klikkikuri-48.png",
        "src/browser-api.js",
        "src/utils.js",
        "src/model.js",
        "src/controller.js",
        "src/config.js",
        "src/storage.js",
        "src/rahti.js",
        "src/rahti/schema.js",
        "src/rahti/fetcher.js",
        "src/rahti/sync.js",
        "src/modifiers.js",
        "src/stats.js",
        "src/feedback.js",
        "src/feedback-card.css",
        "src/options/theme.css",
        "src/options/components.css",
        "src/components/badge-base.js",
        "src/components/highlight-overlay.js",
        "src/components/feedback-dialog.js",
        "src/components/badge-style.js",
        "src/components/klikkikuri-ai-badge.js",
        "src/components/klikkikuri-video-badge.js",
        "src/components/klikkikuri-converted-badge.js",
        "build/js.wasm"
      ],
      "matches": [
        "https://www.iltalehti.fi/*",
        "https://www.hs.fi/*",
        "https://yle.fi/*",
        "https://www.mtvuutiset.fi/*",
        "https://aksa.fi/*",
        "https://www.ampparit.com/*",
        "https://old.reddit.com/*"
      ]
    }
  ],
  "background": {
    "scripts": [
      "src/background.js"
    ],
    "service_worker": "src/background.js",
    "type": "module"
  },
  "host_permissions": [
    "https://raw.githubusercontent.com/Klikkikuri/rahti/*",
    "https://www.iltalehti.fi/*",
    "https://www.hs.fi/*",
    "https://yle.fi/*",
    "https://www.mtvuutiset.fi/*",
    "https://aksa.fi/*"
  ],
  "optional_host_permissions": [
    "https://www.ampparit.com/*",
    "http://localhost/*"
  ],
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "favicon"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none';"
  }
}
